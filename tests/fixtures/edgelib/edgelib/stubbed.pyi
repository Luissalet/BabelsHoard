"""A stub-only module whose names are declared only with @overload (the
numpy.random.Generator shape: no implementation exists in a .pyi)."""
from typing import overload

class Generator:
    @overload
    def normal(self, loc: float = 0.0, scale: float = 1.0, size: None = None) -> float: ...
    @overload
    def normal(self, loc: float = 0.0, scale: float = 1.0, size: int = ...) -> list[float]: ...
    def spawn(self, n_children: int) -> list[Generator]: ...

def default_rng(seed: int | None = None) -> Generator: ...
@overload
def pick(items: list[int]) -> int: ...
@overload
def pick(items: list[str], *, weights: list[float]) -> str: ...
